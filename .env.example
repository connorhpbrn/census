TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ALLOWED_TELEGRAM_USER_ID=
# Optional. Generated and stored next to the db if you use a webhook.
# TELEGRAM_WEBHOOK_SECRET=
DATABASE_PATH=./data/census.db
PORT=3000
# Leave empty on Railway. Set locally only if you need /connect.
PUBLIC_URL=
# Optional. Skip the Telegram place question if both are set.
# CURRENCY=GBP
# TZ=Europe/London
# LOCALE=en-GB
# TrueLayer. Required for /connect. Redirect URI must be exactly $PUBLIC_URL/truelayer
# TRUELAYER_CLIENT_ID=
# TRUELAYER_CLIENT_SECRET=
# TRUELAYER_ENV=live
# Optional. Seeds the db if no bank is connected yet. Do not put an access token here.
# TRUELAYER_REFRESH_TOKEN=
